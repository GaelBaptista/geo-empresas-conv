# URL da API Estagius (troque entre local e produção)
# Local (teste):
# VITE_API_BASE_URL=http://127.0.0.1:3333
# Produção:
VITE_API_BASE_URL=https://estagiusplataform.com.br

# Opcional: JWT manual. Preferível usar a tela de login (POST /sessions com CPF + senha)
# VITE_API_TOKEN=

# --- Minivagas (ranking / observações) ---
# O token NÃO vai para o browser. Proxy:
#   dev  → Vite /api/minivagas (lê este .env no Node)
#   prod → Netlify Function + redirect /api/minivagas
#
# DEV: copiar para .env (não commitar)
MINIVAGAS_TOKEN="cole_seu_token_aqui"
# (compat) também aceita VITE_PUBLIC_TOKEN só no servidor Node / Netlify Functions
# VITE_PUBLIC_TOKEN="cole_seu_token_aqui"
#
# PROD (painel Netlify → Environment variables):
#   MINIVAGAS_TOKEN = mesmo valor  (escopo: Functions)
#   NÃO configure VITE_PUBLIC_TOKEN no build de produção.

# false = usa o dataset local de exemplo em vez da API
# VITE_USE_API=false
