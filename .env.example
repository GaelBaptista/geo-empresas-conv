# URL da API Estagius (troque entre local e produção)
# Local (teste):
# VITE_API_BASE_URL=http://127.0.0.1:3333
# Produção:
VITE_API_BASE_URL=https://estagiusplataform.com.br

# Opcional: JWT manual. Preferível usar a tela de login (POST /sessions com CPF + senha)
# VITE_API_TOKEN=

# --- Minivagas / ranking ---
#
# DEV local (npm run dev):
#   Copie este arquivo para .env e preencha o token.
#   Não commite o .env.
#   VITE_PUBLIC_TOKEN="seu_token_aqui"
#
# PRODUÇÃO (Netlify):
#   NÃO use VITE_PUBLIC_TOKEN no build (vai para o JS do browser).
#   Site settings → Environment variables:
#     MINIVAGAS_TOKEN = seu token   ← Functions (proxy + freeze)
#   Escopo: Functions (e Builds se ainda precisar de legado).
#   Depois: Deploy → Clear cache and deploy site.
#
# NUNCA commite token real (.env.production ou similar).

# false = usa o dataset local de exemplo em vez da API
# VITE_USE_API=false
