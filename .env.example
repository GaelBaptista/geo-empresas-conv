# URL da API Estagius (troque entre local e produção)
# Local (teste):
# VITE_API_BASE_URL=http://127.0.0.1:3333
# Produção:
VITE_API_BASE_URL=https://estagiusplataform.com.br

# Opcional: JWT manual. Preferível usar a tela de login (POST /sessions com CPF + senha)
# VITE_API_TOKEN=

# Token fixo do Minivagas (observações + ranking contratados/reprovados)
# Obrigatório para a aba Ranking. No deploy (Vercel/Netlify/etc), configure
# a mesma variável no painel do host e faça um NOVO build — Vite embute no build.
VITE_PUBLIC_TOKEN=

# false = usa o dataset local de exemplo em vez da API
# VITE_USE_API=false
